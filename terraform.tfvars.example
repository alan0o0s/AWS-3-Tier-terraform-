# Copy this file to terraform.tfvars and adjust values as needed.
# terraform.tfvars is gitignored - never commit real secrets.

project_name = "company-web-platform"
environment  = "production"
aws_region   = "eu-west-1"
owner        = "DevOps"

# Leave availability_zones empty to auto-select az_count AZs, or pin them explicitly:
# availability_zones = ["eu-west-1a", "eu-west-1b"]
az_count = 2

vpc_cidr                 = "10.0.0.0/16"
public_subnet_cidrs      = ["10.0.1.0/24", "10.0.2.0/24"]
private_app_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
private_db_subnet_cidrs  = ["10.0.21.0/24", "10.0.22.0/24"]

instance_type    = "t3.micro"
min_size         = 2
desired_capacity = 2
max_size         = 6
cpu_target       = 50

enable_ssh       = false
ssh_allowed_cidr = "203.0.113.10/32" # replace with your own IP/32 if enable_ssh = true

db_engine                  = "postgres"
db_instance_class          = "db.t3.micro"
db_name                    = "appdb"
db_username                = "app_admin"
# db_password should NOT live here in plaintext for real use.
# Supply it via: export TF_VAR_db_password="..."   (or a secrets-managed pipeline)
db_password = "REPLACE_WITH_A_UNIQUE_SECRET"
storage_size               = 20
backup_retention_period    = 7
multi_az                   = true
enable_deletion_protection = true
skip_final_snapshot        = false
